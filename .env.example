# ==============================================================================
# AI Document Chat (RAG) - Environment Configuration
# ==============================================================================

# Core Application Settings
PROJECT_NAME="AI Document Chat (RAG)"
ENVIRONMENT="development"       # 'development' | 'production' | 'test'
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# AI Provider Configuration
# Set OPENAI_API_KEY to your valid key. If using local embeddings, EMBEDDING_PROVIDER can be 'local'.
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"      # 'gpt-4o' | 'gpt-4o-mini' | 'gpt-3.5-turbo'
OPENAI_TEMPERATURE=0.2

# Embeddings Engine
EMBEDDING_PROVIDER="openai"     # 'openai' | 'local'
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# RAG & Chunking Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
SIMILARITY_SCORE_THRESHOLD=0.7

# Storage & Vector Database
CHROMA_PERSIST_DIRECTORY="./data/chroma_db"
UPLOAD_DIRECTORY="./data/uploads"
MAX_FILE_SIZE_MB=25

# CORS Origins (JSON array format)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:3001", "http://localhost:3002", "http://127.0.0.1:3002"]'

# Frontend Public Variables
NEXT_PUBLIC_API_URL="http://localhost:8000"
